LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-api-key-here
SCREEN_MODEL=gemini-3.5-flash-lite
DRAFT_MODEL=gemini-3.6-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=your-email@gmail.com

# --- WhatsApp Alerts (CallMeBot Free API) ---
# 1. Send 'I allow callmebot to send me messages' to +34 941 86 00 24 on WhatsApp
# 2. Enter phone with country code (e.g. +919876543210) and the API key received
WHATSAPP_PHONE=+919876543210
WHATSAPP_APIKEY=your-callmebot-apikey-here
