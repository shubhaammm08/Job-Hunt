LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-api-key-here
SCREEN_MODEL=gemini-3.5-flash-lite
DRAFT_MODEL=gemini-3.6-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=your-email@gmail.com

# --- WhatsApp Alerts (CallMeBot Free API) ---
# 1. Send 'I allow callmebot to send me messages' to +34 623 78 64 49 on WhatsApp
# 2. Enter phone with country code (e.g. +919876543210) and the API key received
WHATSAPP_PHONE=+919876543210
WHATSAPP_APIKEY=your-callmebot-apikey-here

# --- Telegram Alerts (100% Free / Instant Delivery Alternative) ---
# 1. Message @BotFather on Telegram, send /newbot
# 2. Add your bot token and chat_id here:
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- LinkedIn Scraper Configuration ---
LINKEDIN_SESSION_FILE=session.json
LINKEDIN_HEADLESS=true
LINKEDIN_RATE_LIMIT_DELAY=2.0
LINKEDIN_MAX_PAGES_PER_QUERY=3
